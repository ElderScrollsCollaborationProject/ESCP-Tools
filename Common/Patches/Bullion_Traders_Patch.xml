<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/TraderKindDef[starts-with(defName, "ESCP_Caravan_") and not(contains(defName, "Quartermaster")) and not(contains(defName, "DarkBrotherhood"))]/stockGenerators</xpath>
        <value>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>ESCP_Bullion</tag>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/TraderKindDef[defName="ESCP_Caravan_Imperial_Merchant"]/stockGenerators</xpath>
        <value>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ESCP_Resource_Gold_Ingot</thingDef>
                <countRange>0~3</countRange>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/TraderKindDef[defName="ESCP_Caravan_Imperial_Merchant" or defName="ESCP_Caravan_Altmer_Trader"]/modExtensions</xpath>
        <value>
            <li Class="ESCP.Currencies.BullionBuyer">
                <sellPriceFactor>1.25</sellPriceFactor>
            </li>
        </value>
    </Operation>

</Patch>
