<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationSequence">
					<success>Always</success>
					<operations>
						<li Class="PatchOperationTest">
							<xpath>Defs/StatDef[defName="PsychicEntropyMax"]/parts</xpath>
							<success>Invert</success>
						</li>
						<li Class="PatchOperationAdd">
							<xpath>Defs/StatDef[defName="PsychicEntropyMax"]</xpath>
							<value>
								<parts>
								</parts>
							</value>
						</li>
					</operations>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/StatDef[defName="PsychicEntropyMax"]/parts</xpath>
					<value>
						<li Class="ESCP_Birthsigns_Abilities.StatPart_TheApprenticeNegation">
							<negateOffset>0.5</negateOffset>
							<hediffs>
								<li>ESCP_Birthsign_TheApprentice</li>
							</hediffs>
						</li>
						<li Class="ESCP_Birthsigns_Abilities.StatPart_BirthsignScaledStatOffset">
							<baseFactor>5</baseFactor>							<hediffs>
								<li>ESCP_Birthsign_TheMage</li>
								<li>ESCP_Birthsign_TheApprentice</li>
								<li>ESCP_Birthsign_TheAtronach</li>
							</hediffs>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
