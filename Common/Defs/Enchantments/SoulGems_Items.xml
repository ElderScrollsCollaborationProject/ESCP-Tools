<Defs>

    <ThingDef ParentName="ESCP_EnchantScrollBase">
        <defName>ESCP_EnchantScroll_SoulTrap</defName>
        <label>scroll of soul trap</label>
        <description>Enchanters argue over whether this one is ethical, then go on using it. Fixes the soul trap effect onto the weapon in the reader's hand.</description>
        <comps>
            <li Class="ESCP.Core.Enchantments.CompProperties_EnchantmentScroll">
                <enchantment>ESCP_Enchantment_SoulTrap</enchantment>
            </li>
        </comps>
    </ThingDef>

    <ThingDef Name="ESCP_SoulGemBase" ParentName="ResourceBase" Abstract="True">
        <stackLimit>20</stackLimit>
        <useHitPoints>true</useHitPoints>
        <statBases>
            <MaxHitPoints>30</MaxHitPoints>
            <Mass>0.1</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <thingCategories>
            <li>ESCP_SoulGems</li>
        </thingCategories>
    </ThingDef>

    <ThingDef ParentName="ESCP_SoulGemBase">
        <defName>ESCP_SoulGem_Petty</defName>
        <label>petty soul gem</label>
        <description>An empty petty soul gem. Soul trap a creature of the right size before it dies and this will hold the soul.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Silver</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <MarketValue>40</MarketValue>
        </statBases>
        <tradeTags>
            <li>ESCP_SoulGem</li>
        </tradeTags>
        <comps>
            <li Class="ESCP.Core.Enchantments.CompProperties_SoulGem">
                <tier>0</tier>
                <black>false</black>
                <filledDef>ESCP_SoulGem_Petty_Filled</filledDef>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="ESCP_SoulGemBase">
        <defName>ESCP_SoulGem_Petty_Filled</defName>
        <label>filled petty soul gem</label>
        <description>A petty soul gem with a captured soul inside. Spend it to put 25 charges back into an enchanted weapon.</description>
        <graphicData>
