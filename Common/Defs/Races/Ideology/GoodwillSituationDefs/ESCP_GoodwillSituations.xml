    <GoodwillSituationDef ParentName="ESCP_GoodwillSituation_FactionTag">
        <defName>ESCP_Goodwill_AldmeriKinship</defName>
        <label>Aldmeri Dominion</label>
        <naturalGoodwillOffset>10</naturalGoodwillOffset>
        <modExtensions>
            <li Class="ESCP_RaceTools.FactionGoodwillProperties">
                <FactionTagA>ESCP_Aldmeri</FactionTagA>
                <FactionTagB>ESCP_Aldmeri</FactionTagB>
            </li>
        </modExtensions>
    </GoodwillSituationDef>

