<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <GoodwillSituationDef Name="ESCP_GoodwillSituation_FactionTag" Abstract="True">
        <workerClass>ESCP_RaceTools.GoodWillWorker_UniversalFactionTagCompatibility</workerClass>
    </GoodwillSituationDef>

    <GoodwillSituationDef Name="ESCP_GoodwillSituation_Precept" Abstract="True">
        <workerClass>ESCP_RaceTools.GoodWillWorker_PreceptAndFactionTagCompatibility</workerClass>
