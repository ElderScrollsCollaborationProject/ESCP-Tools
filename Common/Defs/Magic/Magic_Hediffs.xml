<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Magicka</defName>
        <label>magicka</label>
        <description>The reserve of magical energy this person draws on to cast spells. It refills on its own.</description>
        <hediffClass>ESCP.Core.Magic.Hediff_Magicka</hediffClass>
        <defaultLabelColor>(0.5, 0.65, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Ward</defName>
        <label>steadfast ward</label>
        <description>A shimmering barrier is taking the edge off incoming blows.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.75, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1200</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Oakflesh</defName>
        <label>oakflesh</label>
        <description>The skin has gone tough and woody.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.75, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>3600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Conjured</defName>
        <label>conjured</label>
        <description>Summoned here by magic. It will not stay long.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.75, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <comps>
            <li Class="ESCP.Core.Magic.HediffCompProperties_Conjured">
                <lifetimeTicks>3600</lifetimeTicks>
            </li>
        </comps>
    </HediffDef>

</Defs>
