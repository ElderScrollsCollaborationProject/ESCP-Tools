<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Apprentice</defName>
        <label>sign of the Apprentice</label>
        <description>A blessing taken from the Apprentice Stone. Learn quickly and draw magicka back faster, at the cost of a weaker body. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <GlobalLearningFactor>0.25</GlobalLearningFactor>
                    <ESCP_MagickaRegen>0.25</ESCP_MagickaRegen>
                    <ArmorRating_Sharp>-0.1</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Atronach</defName>
        <label>sign of the Atronach</label>
        <description>A blessing taken from the Atronach Stone. A much deeper well of magicka that refills more slowly. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <ESCP_MagickaMax>50</ESCP_MagickaMax>
                    <ESCP_MagickaRegen>-0.1</ESCP_MagickaRegen>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Lady</defName>
        <label>sign of the Lady</label>
        <description>A blessing taken from the Lady Stone. Wounds close faster and illness passes sooner. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <InjuryHealingFactor>0.2</InjuryHealingFactor>
                    <ImmunityGainSpeed>0.1</ImmunityGainSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Lord</defName>
        <label>sign of the Lord</label>
        <description>A blessing taken from the Lord Stone. Hardens the skin against blades and blows. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Lover</defName>
        <label>sign of the Lover</label>
        <description>A blessing taken from the Lover Stone. Everything goes a little easier: work, study, and talking to people. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <GlobalLearningFactor>0.08</GlobalLearningFactor>
                    <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
                    <SocialImpact>0.1</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Mage</defName>
        <label>sign of the Mage</label>
        <description>A blessing taken from the Mage Stone. More magicka to work with, and faster study. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <ESCP_MagickaMax>25</ESCP_MagickaMax>
                    <GlobalLearningFactor>0.15</GlobalLearningFactor>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Ritual</defName>
        <label>sign of the Ritual</label>
        <description>A blessing taken from the Ritual Stone. A steadier mind. People under this stone rarely break. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <MentalBreakThreshold>-0.08</MentalBreakThreshold>
                    <PsychicSensitivity>0.1</PsychicSensitivity>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Stone_Serpent</defName>
        <label>sign of the Serpent</label>
        <description>A blessing taken from the Serpent Stone. Quick hands in a fight, and poison doesn't bite as hard. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
        <isBad>false</isBad>
