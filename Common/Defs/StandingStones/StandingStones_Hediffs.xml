    <HediffDef>
        <defName>ESCP_Hediff_Stone_Warrior</defName>
        <label>sign of the Warrior</label>
        <description>A blessing taken from the Warrior Stone. Hits land more often, and pain doesn't slow you as much. Only one stone's blessing can be held at a time.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
