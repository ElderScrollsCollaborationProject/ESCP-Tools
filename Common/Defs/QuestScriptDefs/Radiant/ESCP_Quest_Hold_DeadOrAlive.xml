<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <QuestScriptDef>
        <defName>ESCP_Quest_Hold_DeadOrAlive</defName>
        <rootSelectionWeight>0.6</rootSelectionWeight>
        <rootMinPoints>100</rootMinPoints>
        <defaultChallengeRating>2</defaultChallengeRating>
        <canGiveRoyalFavor>false</canGiveRoyalFavor>
        <expireDaysRange>4~8</expireDaysRange>
        <questNameRules>
            <rulesStrings>
                <li>questName->Wanted: [outlawName]</li>
                <li>questName->Bounty: [outlawName]</li>
                <li>questName->Dead or Alive</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[asker_nameFull] of [deliverTo_label] has posted a bounty on [outlawName], an outlaw who has been robbing and killing travelers on the roads nearby. The outlaw is holed up in a camp with a band of followers, and the remains of the last caravan they hit are still there.\n\nBring [outlawName] to [deliverTo_label] by caravan, alive or dead, and the bounty will be sent to your colony.</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="QuestNode_SubScript">
                    <def>Util_RandomizePointsChallengeRating</def>
                    <parms>
                        <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
                        <pointsFactorThreeStar>2</pointsFactorThreeStar>
                    </parms>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_AdjustPointsForDistantFight</def>
                </li>
                <li Class="QuestNode_GetMap" />
                <li Class="QuestNode_GetNearbySettlement">
                    <allowActiveTradeRequest>true</allowActiveTradeRequest>
                    <maxTileDistance>60</maxTileDistance>
                    <storeAs>deliverTo</storeAs>
                    <storeFactionAs>deliverFaction</storeFactionAs>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_GetFactionLeader">
                    <faction>$deliverFaction</faction>
                    <storeAs>asker</storeAs>
                </li>
                <li Class="QuestNode_GetSiteTile">
                    <storeAs>siteTile</storeAs>
                    <preferCloserTiles>true</preferCloserTiles>
                </li>
                <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
                    <storeAs>sitePartDefs</storeAs>
                    <storeFactionAs>siteFaction</storeFactionAs>
                    <sitePartsTags>
                        <li><tag>BanditCamp</tag></li>
                    </sitePartsTags>
                    <mustBeHostileToFactionOf>$asker</mustBeHostileToFactionOf>
                </li>
                <li Class="QuestNode_GetDefaultSitePartsParams">
                    <tile>$siteTile</tile>
                    <faction>$siteFaction</faction>
                    <sitePartDefs>$sitePartDefs</sitePartDefs>
                    <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_GenerateSite</def>
                </li>

                <li Class="ESCP.Core.RadiantQuests.QuestNode_GetFactionPawnKind">
                    <faction>$siteFaction</faction>
                    <storeAs>outlawKind</storeAs>
                </li>
                <li Class="QuestNode_GeneratePawn">
                    <kindDef>$outlawKind</kindDef>
                    <faction>$siteFaction</faction>
                    <storeAs>outlaw</storeAs>
                    <addToList>outlaws</addToList>
                </li>
                <li Class="QuestNode_RandomNode">
                    <nodes>
                        <li Class="QuestNode_Set">
                            <name>outlawName</name>
                            <value>Bjarni Three-Fingers</value>
                        </li>
                        <li Class="QuestNode_Set">
                            <name>outlawName</name>
                            <value>Saren Coldtongue</value>
                        </li>
                        <li Class="QuestNode_Set">
                            <name>outlawName</name>
                            <value>Vilja the Knife</value>
                        </li>
                        <li Class="QuestNode_Set">
                            <name>outlawName</name>
                            <value>Grisvar the Unlucky</value>
                        </li>
                        <li Class="QuestNode_Set">
                            <name>outlawName</name>
                            <value>Drevis Hollow-Eye</value>
                        </li>
                    </nodes>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_SetPawnName">
                    <pawn>$outlaw</pawn>
                    <name>$outlawName</name>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_SpawnPawns">
                    <inSignal>site.MapGenerated</inSignal>
                    <pawns>$outlaws</pawns>
                    <mapParent>$site</mapParent>
                </li>

                <li Class="ESCP.Core.RadiantQuests.QuestNode_GetFactionPawnKind">
                    <faction>$deliverFaction</faction>
                    <storeAs>victimKind</storeAs>
                </li>
                <li Class="QuestNode_LoopCount">
                    <loopCount>$(randInt(2,3))</loopCount>
                    <node Class="QuestNode_GeneratePawn">
                        <kindDef>$victimKind</kindDef>
                        <faction>$deliverFaction</faction>
                        <addToList>victims</addToList>
                    </node>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_SpawnCorpses">
                    <inSignal>site.MapGenerated</inSignal>
                    <pawns>$victims</pawns>
                    <radius>8</radius>
                </li>
                <li Class="QuestNode_GeneratePawn">
                    <kindDef>$victimKind</kindDef>
                    <faction>$deliverFaction</faction>
                    <addToList>survivors</addToList>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_DownPawns">
                    <pawns>$survivors</pawns>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_SpawnPawns">
                    <inSignal>site.MapGenerated</inSignal>
                    <pawns>$survivors</pawns>
                    <mapParent>$site</mapParent>
                </li>

                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$site</worldObjects>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_DeliverPawns">
                    <inSignal>deliverTo.CaravanArrived</inSignal>
                    <pawns>$outlaws</pawns>
                    <allowDead>true</allowDead>
                    <outSignalSuccess>bountyDelivered</outSignalSuccess>
                    <outSignalFailed>bountyMissing</outSignalFailed>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>bountyMissing</inSignal>
                    <node Class="QuestNode_Letter">
                        <label>No bounty yet</label>
                        <letterDef>NeutralEvent</letterDef>
                        <text>The guards at [deliverTo_label] look the caravan over and shake their heads. Nobody pays for a bounty until [outlawName] is in hand, alive or dead.</text>
                    </node>
                </li>
                <li Class="ESCP.Core.RadiantQuests.QuestNode_SendRewardCaravan">
                    <inSignal>bountyDelivered</inSignal>
                    <faction>$deliverFaction</faction>
                    <currency>ESCP_Currency_Septims</currency>
                    <rewardValue>$(randInt(250,500))</rewardValue>
                    <guardsCount>2</guardsCount>
                    <letterLabel>Bounty paid</letterLabel>
                    <letterText>A courier from [deliverTo_label] has arrived with the bounty on [outlawName]. The road is a little safer for it.</letterText>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>bountyDelivered</inSignal>
                    <node Class="QuestNode_End">
                        <outcome>Success</outcome>
                        <goodwillChangeAmount>10</goodwillChangeAmount>
                        <goodwillChangeFactionOf>$asker</goodwillChangeFactionOf>
                    </node>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>outlaw.Destroyed</inSignal>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                        <sendStandardLetter>true</sendStandardLetter>
                    </node>
                </li>
                <li Class="QuestNode_WorldObjectTimeout">
                    <worldObject>$site</worldObject>
                    <isQuestTimeout>true</isQuestTimeout>
                    <delayTicks>$(randInt(15,25)*60000)</delayTicks>
                    <inSignalDisable>site.MapGenerated</inSignalDisable>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                        <sendStandardLetter>true</sendStandardLetter>
                    </node>
                </li>
                <li Class="QuestNode_Delay">
                    <delayTicks>$(60*60000)</delayTicks>
                    <isQuestTimeout>true</isQuestTimeout>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                        <sendStandardLetter>true</sendStandardLetter>
                    </node>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>
