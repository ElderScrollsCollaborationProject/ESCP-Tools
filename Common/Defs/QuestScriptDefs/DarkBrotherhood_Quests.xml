<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef>
        <defName>ESCP_Quest_DarkBrotherhood_AssassinationContract</defName>
        <rootSelectionWeight>1.0</rootSelectionWeight>
        <rootMinPoints>300</rootMinPoints>
        <expireDaysRange>8~14</expireDaysRange>
        <canGiveRoyalFavor>false</canGiveRoyalFavor>

        <questNameRules>
            <rulesStrings>
                <li>questName->Dark Brotherhood: [contractLabel]</li>
                <li>contractLabel->Sanctioned Contract</li>
                <li>contractLabel->[targetLabel] Elimination</li>
                <li>contractLabel->[targetLabel] Removal</li>
                <li>targetLabel->High-Value</li>
                <li>targetLabel->Sanctioned</li>
                <li>targetLabel->Marked</li>
            </rulesStrings>
        </questNameRules>

        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[asker_nameDef], Listener of the Dark Brotherhood, has passed down a sanctioned contract. A target has been marked, and [siteFaction_pawnsPlural] are sheltering them at a location the Brotherhood has identified. The Night Mother requires their death.\n\nThe Brotherhood does not require the camp cleared, only the contract fulfilled. Whatever else happens at the site is your business.\n\nPayment is confirmed on completion. The sanctuary contact in [hostFaction_name] is the point of acknowledgement.</li>
            </rulesStrings>
        </questDescriptionRules>

        <root Class="QuestNode_Sequence">
            <nodes>

                <li Class="QuestNode_SubScript">
                    <def>Util_RandomizePointsChallengeRating</def>
                    <parms>
                        <pointsFactorTwoStar>1.4</pointsFactorTwoStar>
                        <pointsFactorThreeStar>1.9</pointsFactorThreeStar>
                    </parms>
                </li>

                <li Class="QuestNode_SubScript">
                    <def>Util_AdjustPointsForDistantFight</def>
                </li>

                <li Class="QuestNode_GetMap">
                    <canBeSpace>false</canBeSpace>
                </li>

                <li Class="ESCP.Guilds.QuestNode_GetGuildFactionLeader">
                    <factionDefName>ESCP_Faction_DarkBrotherhood</factionDefName>
                    <storeLeaderAs>asker</storeLeaderAs>
                    <storeFactionAs>guildFaction</storeFactionAs>
                </li>

                <li Class="ESCP.Guilds.QuestNode_GetGuildBranchFaction">
                    <guild>DarkBrotherhood</guild>
                    <storeAs>hostFaction</storeAs>
                    <maxTechLevel>Medieval</maxTechLevel>
                </li>

                <li Class="QuestNode_GetSiteTile">
                    <storeAs>siteTile</storeAs>
                    <preferCloserTiles>true</preferCloserTiles>
                </li>

                <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
                    <storeAs>sitePartDefs</storeAs>
                    <storeFactionAs>siteFaction</storeFactionAs>
                    <sitePartsTags>
                        <li><tag>BanditCamp</tag></li>
                    </sitePartsTags>
                    <mustBeHostileToFactionOf>$asker</mustBeHostileToFactionOf>
                </li>

                <li Class="QuestNode_GetDefaultSitePartsParams">
                    <tile>$siteTile</tile>
                    <faction>$siteFaction</faction>
                    <sitePartDefs>$sitePartDefs</sitePartDefs>
                    <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
                </li>

                <li Class="QuestNode_GetSiteThreatPoints">
                    <storeAs>sitePoints</storeAs>
                    <sitePartsParams>$sitePartsParams</sitePartsParams>
                </li>

                <li Class="QuestNode_SubScript">
                    <def>Util_GetDefaultRewardValueFromPoints</def>
                    <parms>
                        <points>$sitePoints</points>
                    </parms>
                </li>

                <li Class="QuestNode_SubScript">
                    <def>Util_GenerateSite</def>
                </li>

                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$site</worldObjects>
                </li>

                <li Class="QuestNode_Letter">
                    <label TKey="LetterLabelBrotherhoodContract">Dark Brotherhood: Contract Issued</label>
                    <text TKey="LetterTextBrotherhoodContract">[asker_nameDef] has passed down a sanctioned contract through the sanctuary contact in [hostFaction_name]. The target's location is marked. Check the quest log.</text>
                    <letterDef>PositiveEvent</letterDef>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>guildFaction.BecameHostileToPlayer</inSignal>
                    <outcome>Fail</outcome>
                    <sendStandardLetter>true</sendStandardLetter>
                </li>

                <li Class="QuestNode_WorldObjectTimeout">
                    <worldObject>$site</worldObject>
                    <isQuestTimeout>true</isQuestTimeout>
                    <delayTicks>$(randInt(8,14) * 60000)</delayTicks>
                    <inSignalDisable>site.MapGenerated</inSignalDisable>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelBrotherhoodContractExpired">Contract Withdrawn: [resolvedQuestName]</label>
                                <text TKey="LetterTextBrotherhoodContractExpired">The Brotherhood has sent another agent. The contract is closed.</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

                <li Class="QuestNode_Signal">
                    <inSignal>site.AllEnemiesDefeated</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_GiveRewards">
                                <parms>
                                    <allowGoodwill>true</allowGoodwill>
                                    <allowRoyalFavor>false</allowRoyalFavor>
                                    <rewardValue>$($rewardValue * 1.4)</rewardValue>
                                </parms>
                            </li>
                            <li Class="ESCP.Guilds.QuestNode_GuildReputation">
                                <guild>DarkBrotherhood</guild>
                                <amount>12</amount>
                                <rewardPool>ESCP_ThingSetMaker_DarkBrotherhoodReward</rewardPool>
                            </li>
                        </nodes>
                    </node>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>site.AllEnemiesDefeated</inSignal>
                    <outcome>Success</outcome>
                    <sendStandardLetter>true</sendStandardLetter>
                </li>

                <li Class="QuestNode_NoWorldObject">
                    <worldObject>$site</worldObject>
                    <node Class="QuestNode_End" />
                </li>

            </nodes>
        </root>
    </QuestScriptDef>

    <QuestScriptDef>
        <defName>ESCP_Quest_DarkBrotherhood_EliminationOrder</defName>
        <rootSelectionWeight>0.7</rootSelectionWeight>
        <rootMinPoints>200</rootMinPoints>
        <expireDaysRange>3~6</expireDaysRange>

        <questNameRules>
            <rulesStrings>
                <li>questName->Dark Brotherhood: [orderLabel]</li>
                <li>orderLabel->Elimination Order</li>
                <li>orderLabel->Marked Visitor</li>
                <li>orderLabel->Target in Transit</li>
            </rulesStrings>
        </questNameRules>

        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[asker_nameDef], Listener of the Dark Brotherhood, has passed an unusual order. A marked target will be traveling through the area and will visit [map_definite] as part of their route. They do not know they are marked.\n\nThe contract is simple: the target must not leave alive. The Brotherhood does not care how it is done. If the target departs unharmed, the contract is forfeit and the Brotherhood will note the failure.\n\nPayment is left by a Brotherhood contact once the target is confirmed dead. Acknowledgement passed through [hostFaction_name].</li>
            </rulesStrings>
        </questDescriptionRules>

        <root Class="QuestNode_Sequence">
            <nodes>

                <li Class="QuestNode_GetMap">
                    <canBeSpace>false</canBeSpace>
                </li>

                <li Class="ESCP.Guilds.QuestNode_GetGuildFactionLeader">
                    <factionDefName>ESCP_Faction_DarkBrotherhood</factionDefName>
                    <storeLeaderAs>asker</storeLeaderAs>
                    <storeFactionAs>guildFaction</storeFactionAs>
                </li>

                <li Class="ESCP.Guilds.QuestNode_GetGuildBranchFaction">
                    <guild>DarkBrotherhood</guild>
                    <storeAs>hostFaction</storeAs>
                    <maxTechLevel>Medieval</maxTechLevel>
                </li>

                <li Class="QuestNode_Set">
                    <name>visitDuration</name>
                    <value>$(randInt(3, 6) * 60000)</value>
                </li>

                <li Class="QuestNode_GeneratePawn">
                    <storeAs>target</storeAs>
                    <kindDef>Villager</kindDef>
                    <faction>$hostFaction</faction>
                </li>

                <li Class="QuestNode_Letter">
                    <label TKey="LetterLabelBrotherhoodEliminationOrder">Dark Brotherhood: Marked Visitor</label>
                    <text TKey="LetterTextBrotherhoodEliminationOrder">[asker_nameDef] has issued an Elimination Order. A marked target, [target_nameDef], will visit [map_definite]. [target_nameDef] must not leave alive. Check the quest log.</text>
                    <letterDef>ThreatBig</letterDef>
                </li>

                <li Class="QuestNode_Signal">
                    <inSignal>$inSignal</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_PawnsArrive">
                                <pawns>$target</pawns>
                                <joinPlayer>false</joinPlayer>
                                <arrivalMode>EdgeWalkIn</arrivalMode>
                            </li>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelTargetArrived">Marked Target Arrived</label>
                                <text TKey="LetterTextTargetArrived">[target_nameDef] has arrived. They believe this is a routine visit.</text>
                                <letterDef>NeutralEvent</letterDef>
                            </li>
                            <li Class="QuestNode_Delay">
                                <delayTicks>$visitDuration</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="QuestNode_Letter">
                                            <label TKey="LetterLabelTargetLeaving">Target Departing</label>
                                            <text TKey="LetterTextTargetLeaving">[target_nameDef] is preparing to leave. If [target_pronoun] departs alive, the contract is forfeit.</text>
                                            <letterDef>NegativeEvent</letterDef>
                                        </li>
                                        <li Class="ESCP.Guilds.QuestNode_GuildReputation">
                                            <guild>DarkBrotherhood</guild>
                                            <amount>-15</amount>
                                            <rewardPool>ESCP_ThingSetMaker_DarkBrotherhoodReward</rewardPool>
                                        </li>
                                        <li Class="QuestNode_End">
                                            <outcome>Fail</outcome>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                        </nodes>
                    </node>
                </li>

                <li Class="QuestNode_Signal">
                    <inSignal>target.Killed</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_GiveRewards">
                                <parms>
                                    <allowGoodwill>true</allowGoodwill>
                                    <allowRoyalFavor>false</allowRoyalFavor>
                                    <rewardValue>$($points * 1.3)</rewardValue>
                                </parms>
                            </li>
                            <li Class="ESCP.Guilds.QuestNode_GuildReputation">
                                <guild>DarkBrotherhood</guild>
                                <amount>15</amount>
                                <rewardPool>ESCP_ThingSetMaker_DarkBrotherhoodReward</rewardPool>
                            </li>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelTargetDead">Contract Fulfilled</label>
                                <text TKey="LetterTextTargetDead">[target_nameDef] is dead. The Brotherhood acknowledges the contract fulfilled. Payment will follow.</text>
                                <letterDef>PositiveEvent</letterDef>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Success</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

            </nodes>
        </root>
    </QuestScriptDef>

</Defs>
