<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThoughtDef>
        <defName>ESCP_Thought_Inspection_Commended</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>commended</label>
                <description>My gear passed inspection without a single mark against it.</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_Inspection_Reprimanded</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>reprimanded</label>
                <description>Got called out in front of everyone over the state of my gear.</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_MentorDied</defName>
        <durationDays>6</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>mentor died</label>
                <description>My mentor is gone. I'll have to find my own way now.</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_ObservedMentor</defName>
        <durationDays>0.25</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>watched a mentor</label>
                <description>Spent some time watching my mentor work. Picked up a thing or two.</description>
                <baseMoodEffect>1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_PromotionCeremony</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>promoted</label>
                <description>Stood before the unit and got promoted. Everyone was watching.</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_PunishmentDetail</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>punishment detail</label>
                <description>Got put on punishment detail. Humiliating.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_RankDrilled</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>drilled</label>
                <description>Had a good training drill.</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_RankStudied</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>studied</label>
                <description>Had a productive study session.</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_RankTrained</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>trained hard</label>
                <description>Put in a solid training session today.</description>
                <baseMoodEffect>2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_Thought_WitnessedPromotion</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>witnessed a promotion</label>
                <description>Watched one of our own get promoted. Good for morale.</description>
                <baseMoodEffect>2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
