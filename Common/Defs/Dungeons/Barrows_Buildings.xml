<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>ESCP_Building_DraugrCrypt</defName>
        <label>draugr crypt</label>
        <description>A stone burial niche, freshly broken open from the inside. Something in there is still climbing out. Destroy it and the dead will stop coming.</description>
        <size>(2,2)</size>
        <rotatable>false</rotatable>
        <tickerType>Normal</tickerType>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/Misc/GraveEmpty</texPath>
            <drawSize>(2, 2)</drawSize>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <passability>Impassable</passability>
        <fillPercent>0.6</fillPercent>
        <statBases>
            <MaxHitPoints>350</MaxHitPoints>
            <Flammability>0</Flammability>
        </statBases>
        <building>
            <claimable>false</claimable>
            <deconstructible>false</deconstructible>
        </building>
        <comps>
            <li Class="ESCP.Core.CompProperties_GauntletSpawner">
                <possibleKindDefToSpawn>
                    <li>ESCP_Pawnkind_Draugr</li>
                </possibleKindDefToSpawn>
                <maxCount>6</maxCount>
                <spawnPerTrigger>1</spawnPerTrigger>
                <interval>3000</interval>
                <uiIcon>Things/Building/Misc/GraveEmpty_south</uiIcon>
                <gotoIcon>Things/Building/Misc/GraveEmpty_south</gotoIcon>
                <attackIcon>Things/Building/Misc/GraveEmpty_south</attackIcon>
                <mentalStateDef>ManhunterPermanent</mentalStateDef>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>ESCP_Trap_DraugrAmbush</defName>
        <label>pressure plate</label>
        <description>A carved stone slab set flush with the barrow floor. The old Nords who built these tombs wired them to the burial niches, and anyone who steps on one wakes whatever is sleeping in the walls nearby.</description>
        <thingClass>ESCP.Spawners.Building_TrapSpawnPawns</thingClass>
        <graphicData>
            <texPath>Things/Building/FloorCoverings/SlabTotemicMedium</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <color>(0.55, 0.55, 0.58)</color>
        </graphicData>
        <altitudeLayer>FloorEmplacement</altitudeLayer>
        <rotatable>false</rotatable>
        <tickerType>Normal</tickerType>
        <useHitPoints>false</useHitPoints>
        <statBases>
            <TrapSpringChance>1.0</TrapSpringChance>
        </statBases>
        <building>
            <isTrap>true</isTrap>
            <trapDestroyOnSpring>true</trapDestroyOnSpring>
            <claimable>false</claimable>
            <deconstructible>false</deconstructible>
            <ai_chillDestination>false</ai_chillDestination>
        </building>
        <modExtensions>
            <li Class="ESCP.Spawners.PawnSpawnExtension">
                <kindToSpawn>ESCP_Pawnkind_Draugr</kindToSpawn>
                <spawnAsPlayerFaction>false</spawnAsPlayerFaction>
                <numberToSpawn>2</numberToSpawn>
                <mentalStateDef>ManhunterPermanent</mentalStateDef>
                <message>The pressure plate clicks. Something stirs in the burial niches.</message>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>ESCP_Barrow_Entrance</defName>
        <label>Nordic barrow</label>
        <description>A heavy stone door set into the hillside, carved with the old knotwork. Cold air moves behind it.</description>
        <size>(3,3)</size>
        <useHitPoints>false</useHitPoints>
        <thingClass>ESCP.PocketMaps.PresettableMapPortal</thingClass>
        <rotatable>false</rotatable>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <canOverlapZones>false</canOverlapZones>
        <tickerType>Normal</tickerType>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Building/AncientHatchExit/AncientHatchExit</texPath>
            <drawSize>(3, 3)</drawSize>
        </graphicData>
        <altitudeLayer>FloorEmplacement</altitudeLayer>
        <fillPercent>0</fillPercent>
        <passability>Impassable</passability>
        <holdsRoof>true</holdsRoof>
        <destroyable>false</destroyable>
        <building>
            <isEdifice>true</isEdifice>
            <deconstructible>false</deconstructible>
            <isTargetable>false</isTargetable>
            <isInert>true</isInert>
            <claimable>false</claimable>
            <expandHomeArea>false</expandHomeArea>
        </building>
        <portal>
            <pocketMapGenerator>ESCP_Barrow_MapGen</pocketMapGenerator>
            <exitDef>ESCP_Barrow_Exit</exitDef>
        </portal>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
        <inspectorTabs>
            <li>ITab_ContentsMapPortal</li>
        </inspectorTabs>
        <modExtensions>
            <li Class="ESCP.PocketMaps.ModExtensionPresettablePocketMap">
                <prefabDefs>
                    <li>ESCP_Prefab_Barrow</li>
                </prefabDefs>
                <abandonedMessage>The barrow has collapsed and can no longer be entered.</abandonedMessage>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="PocketMapExit">
        <defName>ESCP_Barrow_Exit</defName>
        <label>barrow stairs</label>
        <description>Worn stone steps leading back up to daylight.</description>
        <size>(1,1)</size>
        <drawerType>RealtimeOnly</drawerType>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Building/AncientHatchExit/AncientHatchExit</texPath>
            <drawSize>(1,1)</drawSize>
        </graphicData>
    </ThingDef>

</Defs>
