                        <iconPath>UI/Deities/ESCP_DeityJulianos</iconPath>
                    </li>
                    <li>
                        <name>Kyne</name>
                        <type>the Warrior&apos;s Widow, Goddess of Storms</type>
                        <gender>Female</gender>
                        <iconPath>UI/Deities/ESCP_DeityKynareth</iconPath>
                    </li>
                    <li>
                        <name>Mara</name>
                        <type>the Mother Goddess</type>
                        <gender>Female</gender>
                        <iconPath>UI/Deities/ESCP_DeityMara</iconPath>
                    </li>
                    <li>
                        <name>Stuhn</name>
                        <type>the God of Ransom</type>
                        <gender>Male</gender>
                        <iconPath>UI/Deities/ESCP_DeityStendarr</iconPath>
                    </li>
                    <li>
                        <name>Zenithar</name>
                        <type>the God of Work and Commerce</type>
                        <gender>Male</gender>
                        <iconPath>UI/Deities/ESCP_DeityZenithar</iconPath>
