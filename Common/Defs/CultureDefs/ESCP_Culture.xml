    <CultureDef>
        <defName>ESCP_Culture_Skaal</defName>
        <label>Skaal</label>
        <description>The culture of the Skaal, an ancient and isolated Nord people who dwell on Solstheim and stand as guardians of the All-Maker's creation. Skaal society prizes communal loyalty, spiritual wisdom, and harmony with the natural world above martial glory. They share everything and take only what they need, carrying the memory of a world older than the current age more intact than any other people of Tamriel.</description>
        <iconPath>UI/Cultures/ESCP_Culture_Imperial</iconPath>
        <pawnNameMaker>ESCP_Nord_Namer_Male</pawnNameMaker>
        <pawnNameMakerFemale>ESCP_Nord_Namer_Female</pawnNameMakerFemale>
        <allowedPlaceTags>
            <li>OriginSpacer</li>
        </allowedPlaceTags>
        <styleItemTags>
            <li>
                <tag>BeardRural</tag>
                <baseWeight>5</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoBeard</tag>
                <baseWeight>0.5</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoTattoo</tag>
                <baseWeight>8</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
        </styleItemTags>
        <thingStyleCategories MayRequire="Ludeon.RimWorld.Ideology">
            <li>
                <category>Rustic</category>
                <priority>2</priority>
            </li>
        </thingStyleCategories>
        <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_NamerIdeo_Skaal</ideoNameMaker>
        <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_NamerDeity_Skaal</deityNameMaker>
