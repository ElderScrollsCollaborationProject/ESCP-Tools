    <CultureDef>
        <defName>ESCP_Culture_Nord</defName>
        <label>Nord</label>
        <description>The culture of the hardy holds of Skyrim: fierce, honorable, and unbroken by cold or war. Nord society prizes martial valor, the glory of battle, and loyalty to one's jarl and kin above all else. Their shieldmaidens match their warriors blow for blow, their skalds keep the deeds of the mighty alive long after the mead hall fires have dimmed, and their dead are spoken of with as much reverence as the living.</description>
        <iconPath>UI/Cultures/ESCP_Culture_Imperial</iconPath>
        <pawnNameMaker>ESCP_Nord_Namer_Male</pawnNameMaker>
        <pawnNameMakerFemale>ESCP_Nord_Namer_Female</pawnNameMakerFemale>
        <allowedPlaceTags>
            <li>OriginSpacer</li>
        </allowedPlaceTags>
        <styleItemTags>
            <li>
                <tag>BeardRural</tag>
                <baseWeight>3</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoBeard</tag>
                <baseWeight>1</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoTattoo</tag>
                <baseWeight>5</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
        </styleItemTags>
        <thingStyleCategories MayRequire="Ludeon.RimWorld.Ideology">
            <li>
                <category>Rustic</category>
                <priority>2</priority>
            </li>
        </thingStyleCategories>
        <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_NamerIdeo_Nord</ideoNameMaker>
        <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_NamerDeity_Nord</deityNameMaker>
        <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_DeityTypeMaker_Nord</deityTypeMaker>
        <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_NamerFestival_Nord</festivalNameMaker>
        <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">ESCP_LeaderTitleMaker_Nord</leaderTitleMaker>
        <modExtensions>
            <li Class="ESCP_RaceTools.IdeoCultureProperties">
                <overrideDivines>true</overrideDivines>
                <overrideNineDivines>true</overrideNineDivines>
                <divinesList>
                    <li>
                        <name>Akatosh</name>
                        <type>the Dragon God of Time</type>
                        <gender>Male</gender>
                        <iconPath>UI/Deities/ESCP_DeityAkatosh</iconPath>
                    </li>
                    <li>
                        <name>Arkay</name>
                        <type>the God of Burials and Seasons</type>
                        <gender>Male</gender>
                        <iconPath>UI/Deities/ESCP_DeityArkay</iconPath>
                    </li>
                    <li>
                        <name>Dibella</name>
                        <type>the Goddess of Beauty</type>
                        <gender>Female</gender>
                        <iconPath>UI/Deities/ESCP_DeityDibella</iconPath>
                    </li>
                    <li>
                        <name>Jhunal</name>
                        <type>the Rune Father</type>
